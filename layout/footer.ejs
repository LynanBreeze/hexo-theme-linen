<footer id="footer">
  <div class="footerInner">
    <div class="footerTop">
      <div class="footerBrand">
        <%
          const footerLogoConfig = theme?.footer?.logo;
          const footerLogoSrc = footerLogoConfig === false
            ? null
            : (footerLogoConfig || '/linen-theme/img/logo_black.svg');
        %>
        <% if (footerLogoSrc) { %>
        <img src="<%=url_for(footerLogoSrc)%>" class="footerLogo" alt="<%=config.title || 'logo'%>" />
        <% } %>
        <% if (theme?.info?.site_desc) { %>
        <p class="footerDesc"><%= theme.info.site_desc %></p>
        <% } %>
      </div>
      <div class="footerLinks">
        <% if (theme?.navItems && theme.navItems.length) { %>
        <div class="footerLinkCol">
          <h4><%= __('common.navigation') %></h4>
          <% theme.navItems.forEach(item => { %>
            <a href="<%=url_for(item.path)%>"><%=item.name%></a>
          <% }); %>
        </div>
        <% } %>
        <%
          const feedDisabled = theme?.feed === false || config?.theme_config?.feed === false;
          const rssPath = feedDisabled ? '' : (config?.feed?.path || theme?.feed?.path || '/feed.xml');
          const footerAuthor = config.author || config.title || '';
        %>
        <% if (rssPath) { %>
        <div class="footerLinkCol">
          <h4><%= __('common.subscribe') %></h4>
          <a href="<%=url_for(rssPath)%>" target="_blank" rel="noopener noreferrer" class="footerRssLink">
            <svg class="rssSvg" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path fill="currentColor" d="M6.18,15.64A2.18,2.18,0,0,1,8.36,17.82a2.18,2.18,0,0,1-2.18,2.18A2.18,2.18,0,0,1,4,17.82,2.18,2.18,0,0,1,6.18,15.64M4,4.44A15.56,15.56,0,0,1,19.56,20h-2.8A12.76,12.76,0,0,0,4,7.24V4.44m0,5.6A9.96,9.96,0,0,1,13.96,20h-2.8A7.16,7.16,0,0,0,4,12.84V10.04Z" />
            </svg>
            <span>RSS</span>
          </a>
        </div>
        <% } %>
        <div class="footerLinkCol footerMetaCol">
          <h4><% if (theme?.info?.about) { %><a href="<%=url_for(theme.info.about)%>"<%- /^(https?:)?\/\//i.test(theme.info.about) ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= __('common.aboutThisSite') %></a><% } else { %><%= __('common.aboutThisSite') %><% } %></h4>
          <span class="footerMetaText copyright">
            <span class="copyright-popover-container">
              <span class="copyright-trigger" role="button" tabindex="0" aria-haspopup="true" aria-label="<%=__('common.copyrightTitle')%>">&copy;&#xFE0E;</span>
              <span class="copyright-popover-content">
                <span class="copyright-popover-arrow"></span>
                <span class="copyright-popover-header">
                  <svg class="copyright-popover-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2V7h-2v2z"/>
                  </svg>
                  <span class="copyright-popover-title"><%=__('common.copyrightTitle')%></span>
                </span>
                <span class="copyright-popover-text"><%= theme?.info?.copyright || __('common.copyright') %></span>
              </span>
            </span>&nbsp;<%= [date(Date.now(), 'YYYY'), footerAuthor].filter(Boolean).join(' ') %>
          </span>
          <span class="footerMetaText">
            Powered by <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a> & <a href="https://github.com/LynanBreeze/hexo-theme-linen" target="_blank" rel="noopener noreferrer">Linen</a>
          </span>
          <% if (theme?.info?.registration) { %>
          <span class="footerMetaText registration">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"><%=theme.info.registration%></a>
          </span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</footer>