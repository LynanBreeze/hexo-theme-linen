<%
const visiblePosts = site.posts?.filter(post => !post?.hide?.archive) || [];
const series = Array.from(new Set(visiblePosts.filter(item => item.series).map(item => item.series)));
const visibleCategoriesCount = site.categories && typeof site.categories.toArray === 'function'
  ? site.categories.toArray().filter(cat => (cat.posts ? cat.posts.filter(post => !post?.hide?.archive).length : cat.length) > 0).length
  : (site.categories?.length || 0);
const visibleTagsCount = site.tags && typeof site.tags.toArray === 'function'
  ? site.tags.toArray().filter(tag => (tag.posts ? tag.posts.filter(post => !post?.hide?.archive).length : tag.length) > 0).length
  : (site.tags?.length || 0);
%>
<div class="site-info<%=is_home_first_page() ? ' home' : ''%>">
  <div class="info-row">
    <div class="author">
      <img class="avatar" src="<%=url_for(theme?.info?.avatar || '/linen-theme/img/vue-color-avatar.png')%>" alt="" />
      <div class="name"><%=config?.author || ''%></div>
    </div>
  </div>
  <% if (theme?.info?.site_desc) { %>
    <div class="info-row description"><%=theme?.info?.site_desc%></div>
  <% } %>
  <div class="info-row site-stats">
    <a href="<%=url_for('/archives/#archives')%>" target="_self"><%=visiblePosts.length%> <%=__('common.posts')%></a>
    <span class="divider">/</span>
    <a href="<%=url_for('/archives/#categories')%>" target="_self"><%=visibleCategoriesCount%> <%=__('common.categories')%></a>
    <span class="divider">/</span>
    <a href="<%=url_for('/archives/#tags')%>" target="_self"><%=visibleTagsCount%> <%=__('common.tags')%></a>
    <% if (series.length) { %>
    <span class="divider">/</span>
    <a href="<%=url_for('/archives/#series')%>" target="_self"><%=series.length%> <%=__('common.series')%></a><% } %>
  </div>
</div>