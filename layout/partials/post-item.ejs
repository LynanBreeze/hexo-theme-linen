<article class="post-item">
  <div class="item-body<% if (post.thumbnail || post.cover) { %> has-cover<% } %>">
    <% if (post.thumbnail || post.cover) { %>
    <div class="cover-img">
      <img src="<%=url_for(post.thumbnail || post.cover)%>" alt="" loading="lazy" />
    </div>
    <% } %>
    <div class="title-excerpt">
      <div class="title-excerpt-text">
        <a class="title" href="<%=url_for(post.path)%>"><%=post.title%><% if (post.subTitle) { %><span class="sub-title"><%=post.subTitle%></span><% } %></a>
        <% if(post?.tags?.length) { %>
          <div class="tags">
            <% (post.tags || []).forEach(tag => { %>
              <a class="tag-item<%= is_tag() && page.tag === tag.name ? ' is-current' : '' %>" href="<%=url_for(`/${tag.path}`)%>"><%=tag.name%></a>
            <% }) %>
          </div>
        <% } %>
        <div class="excerpt"><%-post?.excerpt||''%></div>
      </div>
      <div class="post-meta">
        <% if (post.date && !date(post.date).startsWith('1970')) { %>
        <time class="date" datetime="<%=post.date.toJSON()%>">
          <%=getPostDate(post)%>
        </time>
        <% } %>
        <span class="categories">
          <% (post?.categories || []).forEach(category => { %>
          <a class="category-item" href="<%=url_for(`/${category.path}`)%>"><%=category.name%></a>
          <% }); %>
        </span>
        <span class="read-time"><%-partial('partials/words', { post, count: false, readTime: true })%></span>
      </div>
    </div>
  </div>
</article>
