<%
  const content = post?.content || "";
  const text = content
    .replace(/<figure[^>]*>.*?<\/figure>/gs, "")
    .replace(/<pre\b[^>]*>[\s\S]*?<\/pre>/gi, "")
    .replace(/<span class="pswp-caption-content">.*?<\/span>/gs, "")
    .replace(/<span class="katex-mathml">.*?<\/span>/gs, "")
    .replace(/<noscript[^>]*>.*?<\/noscript>/gs, "")
    .replace(/<style[^>]*>.*?<\/style>/gs, "")
    .replace(/<script[^>]*>.*?<\/script>/gs, "")
    .replace(/<\/?[^>]+(>|$)/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&#(\d+);/g, (_, dec) => String.fromCodePoint(Number(dec)))
    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))
    .replace(/&(amp|lt|gt|quot|apos|ldquo|rdquo|lsquo|rsquo|mdash|ndash|hellip);/gi, (_, name) => ({
      amp: "&",
      lt: "<",
      gt: ">",
      quot: '"',
      apos: "'",
      ldquo: "“",
      rdquo: "”",
      lsquo: "‘",
      rsquo: "’",
      mdash: "—",
      ndash: "–",
      hellip: "…",
    })[name.toLowerCase()] || " ")
    .replace(/&[a-zA-Z]+;/g, " ");

  const currentLanguage = page?.language || config?.language || "";
  const isEnglish = /^en\b/i.test(String(currentLanguage));
  const comma = isEnglish ? ", " : "，";
  const words = isEnglish
    ? (text.trim().match(/\S+/g) || []).length
    : text.replace(/\s+/g, "").length;

  const galleryMatches = content.match(/class="[^"]*\bgallery-item\b/gi);
  const photos = galleryMatches
    ? galleryMatches.length
    : (content.match(/<img\b(?![^>]*\b(?:linen-emoji|not-gallery-item)\b)[^>]*>/gi) || []).length;

  const wordLabel = words ? `${words} ${__('common.words')}` : "";
  const photoLabel = photos
    ? `${photos} ${photos > 1 ? __('common.photos') : __('common.photo')}`
    : "";
  const countsText = [wordLabel, photoLabel].filter(Boolean).join(comma);

  let primaryText = "";
  let detailText = "";

  if (readTime) {
    const mins = estimateReadingTime(text, photos, content);
    primaryText = `${__('common.approximately')} ${mins} ${__('common.minsRead')}`;
    if (count && countsText) {
      detailText = `(${countsText})`;
    }
  } else if (count && countsText) {
    primaryText = `${__('common.approximately')} ${countsText}`;
  }
%><% if (primaryText) { %><span><%= primaryText %></span><% } %><% if (detailText) { %> <small><%= detailText %></small><% } %>
