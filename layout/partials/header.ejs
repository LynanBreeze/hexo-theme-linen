<% 
const { hasTranslatation, targetLanguagePath, targetLanguage } = getTranslationPage();

const logoConfig = theme?.logo || {};
const { src: logoSrc, text: logoText, width: logoWidth, height: logoHeight } = logoConfig;
const rssPath = config?.feed?.path || theme?.feed?.path;
const showThemeToggle = (theme?.themeToggle ?? config?.theme_config?.themeToggle ?? true) !== false;
%>

<% if (is_post()) { %>
<div class="nav-header-placeholder"></div>
<% } %>
<div class="nav-header<%=is_post() ? ' is-post': ''%>">
  <div class="header-inner">
    <a class="title<%= !logoSrc ? ' default-logo' : '' %>" href="<%=url_for('/')%>" title="index" style="<%=[logoSrc ? `background-image: url(${url_for(logoSrc)})`: '', logoWidth && logoHeight ? `aspect-ratio: ${logoWidth}/${logoHeight}` : ''].filter(v => v).join(';')%>"><%=logoText||''%></a>
    <div class="right">
      <div class="navItems">
        <% (theme?.navItems || []).forEach(({ name, path }) => { %>
        <a class="navItem<%=`/${page.path}`.startsWith(path) ? ' active' : ''%>" href="<%=url_for(path)%>"><%=name%></a>
        <% }); %>
      </div>
      <div class="buttonSet">
        <% if (page.hdrSwitch) { %>
        <button type="button" class="button hdr-switch" title="Switch HDR/SDR content" aria-label="Switch HDR/SDR content"></button>
        <script>
          if (window.innerWidth >= 500 && window.matchMedia && window.matchMedia("(dynamic-range: high)").matches && typeof CSS !== "undefined" && CSS.supports && CSS.supports("dynamic-range-limit: no-limit")) {
            var hdrBtn = document.currentScript && document.currentScript.previousElementSibling;
            if (hdrBtn) hdrBtn.classList.add("hdr_on");
          }
        </script>
        <% } %>
        <% if (hasTranslatation) { %>
        <a class="button language <%=targetLanguage%>" href="<%=targetLanguagePath%>" target="_self" title="switch language" aria-label="Switch language"></a>
        <% } %>
        <% if (theme?.info?.github) { %>
        <a class="button github" href="<%=theme?.info?.github || ''%>" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub"></a>
        <% } %>
        <% if (rssPath) { %>
          <a class="button rss" href="<%=url_for(rssPath)%>" target="_blank" rel="noopener noreferrer" title="RSS" aria-label="RSS"></a>
        <% } %>
        <% if (showThemeToggle) { %>
        <button
          type="button"
          id="theme-toggle"
          class="button theme-toggle"
          title="<%=__('common.toggleTheme')%>"
          aria-label="<%=__('common.toggleTheme')%>"
        >
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.25" />
            <path d="M12 2.5v2.25M12 19.25v2.25M4.93 4.93l1.59 1.59M17.48 17.48l1.59 1.59M2.5 12h2.25M19.25 12h2.25M4.93 19.07l1.59-1.59M17.48 6.52l1.59-1.59" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.354 15.354A8.5 8.5 0 0 1 8.646 3.646 8.5 8.5 0 1 0 20.354 15.354z" />
          </svg>
        </button>
        <% } %>
        <% if (hasTocs) { %>
        <button
          type="button"
          id="toc-toggle"
          class="button toc"
          title="<%=__('common.toc')%>"
          aria-label="<%=__('common.toc')%>"
          aria-controls="toc"
          aria-expanded="false"
        ></button>
        <% } %>
      </div>
    </div>
  </div>
</div>