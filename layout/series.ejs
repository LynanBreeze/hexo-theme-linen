<%
const isTravelSeries = ['旅行', 'Travel'].includes(page.series);
const seriesPosts = page.seriesPosts || (page.posts ? (Array.isArray(page.posts) ? page.posts : page.posts.toArray()) : []);
const currentSeriesPosts = page.posts ? (Array.isArray(page.posts) ? page.posts : page.posts.toArray()) : seriesPosts;
const totalCount = seriesPosts.length;
const years = seriesPosts
  .map(p => (p.date && p.date.year ? p.date.year() : (p.date ? new Date(p.date).getFullYear() : null)))
  .filter(y => y && y > 1970);
const minYear = years.length ? Math.min(...years) : null;
const maxYear = years.length ? Math.max(...years) : null;
const yearRange = minYear && maxYear ? (minYear === maxYear ? `${minYear}` : `${minYear} — ${maxYear}`) : '';
const seriesCountMap = new Map();
site.posts.forEach(post => {
  if (!post.series) return;
  seriesCountMap.set(post.series, (seriesCountMap.get(post.series) || 0) + 1);
});
const seriesList = Array.from(seriesCountMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const parseMapCoordinate = (post) => {
  if (post?.mapPlace?.coordinate?.length === 2) {
    return { lat: Number(post.mapPlace.coordinate[0]), lng: Number(post.mapPlace.coordinate[1]) };
  }

  const mapUrl = post?.mapPlace?.url || post?.coverInfo?.url;
  if (!mapUrl) return null;

  try {
    const url = new URL(mapUrl);
    const value = url.searchParams.get('coordinate') || url.searchParams.get('ll');
    if (!value) return null;

    const [lat, lng] = value.split(',').map(Number);
    if (Number.isFinite(lat) && Number.isFinite(lng)) {
      return { lat, lng };
    }
  } catch (error) {
    return null;
  }

  return null;
};
const travelPlaces = isTravelSeries ? page.seriesPosts.map((post, index) => {
  const coordinate = parseMapCoordinate(post);
  if (!coordinate) return null;
  return {
    id: `travel-place-${index}`,
    title: post.title,
    subTitle: post.subTitle || '',
    path: url_for(post.path),
    date: post.date && !date(post.date).startsWith('1970') ? getPostDate(post) : '',
    location: post?.mapPlace?.location || post?.coverInfo?.location || post.title,
    excerpt: post?.excerpt || '',
    cover: (post.thumbnail || post.cover) ? url_for(post.thumbnail || post.cover) : '',
    mapUrl: post?.mapPlace?.url || post?.coverInfo?.url || '',
    lat: coordinate.lat,
    lng: coordinate.lng,
  };
}).filter(Boolean) : [];
const travelPlacesJson = encodeURIComponent(JSON.stringify(travelPlaces));
%>

<div class="series-layout<%=isTravelSeries && travelPlaces.length ? ' travel-series-layout' : ''%>">
  <% if (page.seriesInfo?.cover && !isTravelSeries) { %>
  <div class="series-cover-img-wrap" style="<%=page.seriesInfo?.coverPlaceholder ? `background-image: url(${url_for(page.seriesInfo.coverPlaceholder)})`: ''%>">
    <div class="series-cover-img-placeholder"></div>
    <script>
      const coverImgStartTime = Date.now();
      setTimeout(() => {
        const seriesCoverImg = document.getElementById('seriesCoverImg');
        if (seriesCoverImg && !seriesCoverImg.classList.contains('loaded') && !seriesCoverImg.classList.contains('cached')) {
          seriesCoverImg.classList.add('loading')
        }
      }, 100);

      function onseriesCoverImgLoaded(img) {
        if (Date.now() - coverImgStartTime > 300) {
          img.classList.add('loaded')
        } else {
          img.classList.add('cached')
        }
      }
    </script>
    <img id="seriesCoverImg" class="cover-img" src="<%=url_for(page.seriesInfo.cover)%>" alt="" onload="onseriesCoverImgLoaded(this)" />
    <div class="cover-info">
      <div class="series-info">
        <h1 class="series-name"><%=__('common.series') + ': ' + page.series %></h1>
        <div class="description"><%=page.seriesInfo.description||''%> <i class="post-count-icon"></i><%=__('common.total')%> <%=page?.seriesPosts?.length%> <%=__('common.seriesPostCount')%></div>
      </div>
      <% if(page.seriesInfo?.coverInfo) { %>
      <% if(page.seriesInfo.coverInfo.url) { %>
      <a class="copyright link" href="<%=page.seriesInfo.coverInfo.url%>" target="_blank">
        <% } else { %>
        <div class="copyright">
          <% } %>
          <span class="icon<%=page.seriesInfo.coverInfo.location? ' location': ''%>"></span>
          <span class="text"><%=page.seriesInfo.coverInfo.author||page.seriesInfo.coverInfo.location%></span>
          <% if(page.seriesInfo.coverInfo.url) { %>
      </a>
      <% } else { %>
    </div>
    <% } %>
  </div>
  <% } %>
</div>
<% } else if (!isTravelSeries) { %>
<%-partial('partials/taxonomy-header', {
  type: 'series',
  title: page.series,
  count: totalCount,
  yearRange,
  description: page?.seriesInfo?.description || '',
  kindLabel: __('common.series'),
  kindUrl: url_for('/archives/#series')
})%>
<% } %>

<% if (isTravelSeries && travelPlaces.length) { %>
<noscript>
  <link rel="stylesheet" href="<%-url_for('/linen-theme/css/leaflet.css')%>" />
</noscript>
<section class="travel-map-section" aria-label="<%=page.series === 'Travel' ? 'Travel map' : '旅行地图'%>">
  <div class="travel-map-panel">
    <div class="travel-map-copy">
      <div class="travel-map-eyebrow"><%=page.series === 'Travel' ? 'Travel Map' : '旅行地图'%></div>
      <h2><%=page.series === 'Travel' ? 'Places I have been' : '去过的地方'%></h2>
      <div class="travel-map-stats">
        <span><%=travelPlaces.length%></span>
        <%=page.series === 'Travel' ? 'mapped trips' : '次旅行足迹'%>
      </div>
    </div>
    <div id="travel-map" class="travel-map-canvas" data-places="<%=travelPlacesJson%>">
      <div class="travel-map-loading"><%=page.series === 'Travel' ? 'Loading map...' : '地图加载中...'%></div>
      <noscript>
        <img
          class="travel-map-fallback-img"
          src="<%=url_for('/linen-theme/img/travel-map-fallback.svg')%>"
          alt="<%=page.series === 'Travel' ? 'Static travel map' : '旅行地图静态图'%>"
        />
      </noscript>
    </div>
  </div>
  <div class="travel-place-list">
    <% travelPlaces.forEach((place, index) => { %>
    <article class="travel-place-card" data-travel-place="<%=place.id%>" href="<%=place.path%>" onclick="onclickPostItem(this)">
      <a href="<%=place.path%>" class="travel-place-cover" aria-label="<%=place.title%>" onclick="event.stopPropagation()">
        <span class="travel-place-index"><%=String(travelPlaces.length - index).padStart(2, '0')%></span>
        <% if (place.cover) { %>
        <div class="cover-img">
          <img src="<%=place.cover%>" alt="" loading="lazy" />
        </div>
        <% } %>
      </a>
      <div class="travel-place-body">
        <a class="travel-place-title" href="<%=place.path%>" onclick="event.stopPropagation()"><%=place.title%><% if (place.subTitle) { %><span class="sub-title"><%=place.subTitle%></span><% } %></a>
        <div class="travel-place-meta"><%=place.location%><% if (place.date) { %><span><%=place.date%></span><% } %></div>
        <div class="travel-place-excerpt"><%-place.excerpt%></div>
      </div>
    </article>
    <% }) %>
  </div>
</section>
<script>
  (() => {
    const mapEl = document.getElementById('travel-map');
    if (!mapEl) return;

    // Leaflet assets will be loaded asynchronously below.

    const initMapData = () => {
      const places = JSON.parse(decodeURIComponent(mapEl.dataset.places || '%5B%5D'));
      const items = document.querySelectorAll('[data-travel-place]');
      const setActive = (id, active) => {
        items.forEach((item) => {
          if (item.dataset.travelPlace === id) item.classList.toggle('active', active);
        });
      };

      const placeGroups = places.reduce((groups, place) => {
        const key = `${place.lat.toFixed(3)},${place.lng.toFixed(3)}`;
        if (!groups.has(key)) {
          groups.set(key, {
            lat: place.lat,
            lng: place.lng,
            places: [],
          });
        }
        groups.get(key).places.push(place);
        return groups;
      }, new Map());

      const escapeHtml = (value = '') => String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      const getPopupHtml = (group) => {
        const listItems = group.places
          .map((place) => {
            const subTitle = place.subTitle ? `<small class="travel-map-popup-subtitle">${escapeHtml(place.subTitle)}</small>` : '';
            const coverImg = place.cover ? `<img class="travel-map-popup-cover" src="${escapeHtml(place.cover)}" alt="" />` : '';
            return `<a class="travel-map-popup-record" href="${escapeHtml(place.path)}">${coverImg}<div class="travel-map-popup-content"><span>${escapeHtml(place.title)}${subTitle}</span><small>${escapeHtml(place.date || place.location)}</small></div></a>`;
          })
          .join('');
        return `<div class="travel-map-popup-list">${listItems}</div>`;
      };

      const bindCardEvents = (markers) => {
        items.forEach((item) => {
          const id = item.dataset.travelPlace;
          const getEl = markers.get(id);
          const toggle = (active) => {
            setActive(id, active);
            const el = getEl ? getEl() : null;
            if (el) el.classList.toggle('active', active);
          };
          item.addEventListener('mouseenter', () => toggle(true));
          item.addEventListener('mouseleave', () => toggle(false));
          item.addEventListener('focus', () => toggle(true));
          item.addEventListener('blur', () => toggle(false));
        });
      };

      return { placeGroups, setActive, getPopupHtml, bindCardEvents };
    };

    const mapLanguage = '<%=String(page.language || config.language || "").startsWith("zh") ? "zh" : "en"%>';
    let fallbackTriggered = false;

    const initLeafletMap = () => {
      if (!window.L) {
        mapEl.innerHTML = '<div class="travel-map-loading"><%=page.series === "Travel" ? "Map failed to load." : "地图加载失败。"%></div>';
        return;
      }

      const { placeGroups, setActive, getPopupHtml, bindCardEvents } = initMapData();
      const markers = new Map();
      mapEl.innerHTML = '';

      const tileConfig = mapLanguage === 'zh'
        ? {
          url: 'https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}',
          options: {
            maxZoom: 18,
            subdomains: ['1', '2', '3', '4'],
            attribution: '&copy; 高德地图',
          },
        }
        : {
          url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          options: {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          },
        };
      const map = L.map(mapEl, {
        scrollWheelZoom: false,
        attributionControl: true,
        tap: false,
      });
      L.tileLayer(tileConfig.url, tileConfig.options).addTo(map);

      const createMarkerIcon = (count = 1) => L.divIcon({
        className: 'travel-leaflet-marker',
        html: `<span data-place-count="${count}">${count > 1 ? `<strong>${count}</strong>` : ''}</span>`,
        iconSize: [18, 18],
        iconAnchor: [9, 9],
        popupAnchor: [0, -10],
      });
      const bounds = [];

      placeGroups.forEach((group) => {
        const placeCount = group.places.length;
        const marker = L.marker([group.lat, group.lng], { icon: createMarkerIcon(placeCount) })
          .addTo(map)
          .bindPopup(getPopupHtml(group));
        group.places.forEach((place) => markers.set(place.id, () => marker.getElement()));
        bounds.push([group.lat, group.lng]);

        marker.on('mouseover', () => {
          const el = marker.getElement();
          if (el) el.classList.add('active');
          group.places.forEach((place) => setActive(place.id, true));
        });
        marker.on('mouseout', () => {
          const el = marker.getElement();
          if (el) el.classList.remove('active');
          group.places.forEach((place) => setActive(place.id, false));
        });
      });

      if (bounds.length) {
        map.fitBounds(bounds, { padding: [28, 28] });
        map.setMinZoom(map.getZoom());
      }

      bindCardEvents(markers);
    };

    const loadLeafletFallback = () => {
      if (fallbackTriggered) return;
      fallbackTriggered = true;

      if (!document.querySelector('link[href*="leaflet.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '<%-url_for("/linen-theme/css/leaflet.css")%>';
        document.head.appendChild(link);
      }

      if (window.L) {
        initLeafletMap();
      } else {
        const script = document.createElement('script');
        script.src = '<%-url_for("/linen-theme/js/leaflet.js")%>';
        script.async = true;
        script.onload = initLeafletMap;
        script.onerror = () => {
          mapEl.innerHTML = '<div class="travel-map-loading"><%=page.series === "Travel" ? "Map failed to load." : "地图加载失败。"%></div>';
        };
        document.body.appendChild(script);
      }
    };

    const initMapLibreMap = () => {
      if (!window.maplibregl) {
        loadLeafletFallback();
        return;
      }

      const { placeGroups, setActive, getPopupHtml, bindCardEvents } = initMapData();
      const markers = new Map();
      mapEl.innerHTML = '';

      let styleLoaded = false;
      let map;
      try {
        map = new window.maplibregl.Map({
          container: mapEl,
          style: 'https://tiles.openfreemap.org/styles/liberty',
          center: [108, 34],
          zoom: 3.2,
          scrollZoom: false,
          dragRotate: false,
          pitchWithRotate: false,
          attributionControl: false,
        });
      } catch (error) {
        loadLeafletFallback();
        return;
      }

      map.addControl(new window.maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      map.addControl(new window.maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const fallbackTimer = setTimeout(() => {
        if (!styleLoaded) {
          try { map.remove(); } catch (e) {}
          loadLeafletFallback();
        }
      }, 8000);

      map.on('error', () => {
        if (!styleLoaded) {
          clearTimeout(fallbackTimer);
          try { map.remove(); } catch (e) {}
          loadLeafletFallback();
        }
      });

      map.on('style.load', () => {
        styleLoaded = true;
        clearTimeout(fallbackTimer);

        const labelExpr = mapLanguage === 'zh'
          ? ['coalesce', ['get', 'name:zh'], ['get', 'name:zh-Hans'], ['get', 'name']]
          : ['coalesce', ['get', 'name:en'], ['get', 'name:latin'], ['get', 'name']];

        const layers = map.getStyle().layers || [];
        layers.forEach((layer) => {
          if (layer.type !== 'symbol' || !layer.layout || !layer.layout['text-field']) return;
          const fieldStr = JSON.stringify(layer.layout['text-field']);
          if (fieldStr.includes('name')) {
            try {
              map.setLayoutProperty(layer.id, 'text-field', labelExpr);
            } catch (e) {}
          }
        });
      });

      const bounds = new window.maplibregl.LngLatBounds();

      placeGroups.forEach((group) => {
        const placeCount = group.places.length;
        const markerEl = document.createElement('div');
        markerEl.className = 'travel-leaflet-marker';
        markerEl.innerHTML = `<span data-place-count="${placeCount}">${placeCount > 1 ? `<strong>${placeCount}</strong>` : ''}</span>`;

        const popup = new window.maplibregl.Popup({
          offset: 14,
          closeButton: true,
          maxWidth: '260px',
        }).setHTML(getPopupHtml(group));

        new window.maplibregl.Marker({ element: markerEl, anchor: 'center' })
          .setLngLat([group.lng, group.lat])
          .setPopup(popup)
          .addTo(map);

        group.places.forEach((place) => markers.set(place.id, () => markerEl));
        bounds.extend([group.lng, group.lat]);

        markerEl.addEventListener('mouseenter', () => {
          markerEl.classList.add('active');
          group.places.forEach((place) => setActive(place.id, true));
        });
        markerEl.addEventListener('mouseleave', () => {
          markerEl.classList.remove('active');
          group.places.forEach((place) => setActive(place.id, false));
        });
      });

      if (!bounds.isEmpty()) {
        map.fitBounds(bounds, {
          padding: 40,
          maxZoom: 11,
          duration: 0,
        });
        map.setMinZoom(Math.max(1, map.getZoom() - 0.5));
      }

      bindCardEvents(markers);
    };

    const hasWebGL = (() => {
      try {
        const canvas = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (canvas.getContext('webgl2') || canvas.getContext('webgl')));
      } catch (e) {
        return false;
      }
    })();

    const loadResources = () => {
      if (!hasWebGL) {
        loadLeafletFallback();
        return;
      }

      const mapLibreCss = 'https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.css';
      const mapLibreJs = 'https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.js';

      if (!document.querySelector('link[href*="maplibre-gl.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = mapLibreCss;
        document.head.appendChild(link);
      }

      if (window.maplibregl) {
        initMapLibreMap();
      } else {
        const script = document.createElement('script');
        script.src = mapLibreJs;
        script.async = true;
        script.onload = initMapLibreMap;
        script.onerror = loadLeafletFallback;
        document.body.appendChild(script);
      }
    };

    // Use requestIdleCallback or setTimeout to yield the main thread and prevent blocking initial paint/layout of the place list
    if (window.requestIdleCallback) {
      window.requestIdleCallback(() => loadResources());
    } else {
      setTimeout(loadResources, 100);
    }
  })();
</script>
<% } %>

<% if (!isTravelSeries) { %>
<div class="posts-info-layout">
  <div class="posts-wrap">
    <div id="recent-posts">
      <% currentSeriesPosts.forEach(post => { %>
      <%-partial('partials/post-item', { post: post })%> <% }) %>
    </div>
    <%-partial('partials/paginator')%>
  </div>
  <div class="info-wrap">
    <%-partial('partials/site-info')%>
    <%-partial('partials/taxonomy-sidebar', { type: 'series', items: seriesList, current: page.series })%>
  </div>
</div>
<% } %>
</div>
