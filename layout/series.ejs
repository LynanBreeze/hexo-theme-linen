<%
const isTravelSeries = isMapSeries(page.series, page.seriesInfo);
const isEnglishMap = String(page.language || config.language || '').startsWith('en') || page.series === 'Travel';
const seriesPosts = page.seriesPosts || (page.posts ? (Array.isArray(page.posts) ? page.posts : page.posts.toArray()) : []);
const currentSeriesPosts = page.posts ? (Array.isArray(page.posts) ? page.posts : page.posts.toArray()) : seriesPosts;
const totalCount = seriesPosts.length;
const years = seriesPosts
  .map(p => (p.date && p.date.year ? p.date.year() : (p.date ? new Date(p.date).getFullYear() : null)))
  .filter(y => y && y > 1970);
const minYear = years.length ? Math.min(...years) : null;
const maxYear = years.length ? Math.max(...years) : null;
const yearRange = minYear && maxYear ? (minYear === maxYear ? `${minYear}` : `${minYear} — ${maxYear}`) : '';
const seriesCountMap = new Map();
site.posts.forEach(post => {
  if (!post.series || post?.hide?.archive) return;
  seriesCountMap.set(post.series, (seriesCountMap.get(post.series) || 0) + 1);
});
const seriesList = Array.from(seriesCountMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const parseMapCoordinate = (post) => {
  if (post?.mapPlace?.coordinate?.length === 2) {
    const lat = Number(post.mapPlace.coordinate[0]);
    const lng = Number(post.mapPlace.coordinate[1]);
    if (Number.isFinite(lat) && Number.isFinite(lng)) {
      return { lat, lng };
    }
  }

  const mapUrl = post?.mapPlace?.url || post?.coverInfo?.url;
  if (!mapUrl) return null;

  try {
    const url = new URL(mapUrl);
    const value = url.searchParams.get('coordinate') || url.searchParams.get('ll');
    if (!value) return null;

    const [lat, lng] = value.split(',').map(Number);
    if (Number.isFinite(lat) && Number.isFinite(lng)) {
      return { lat, lng };
    }
  } catch (error) {
    return null;
  }

  return null;
};
const allTravelCards = isTravelSeries ? seriesPosts.map((post, index) => {
  const coordinate = parseMapCoordinate(post);
  return {
    id: coordinate ? `travel-place-${index}` : '',
    title: post.title,
    subTitle: post.subTitle || '',
    path: url_for(post.path),
    date: post.date && !date(post.date).startsWith('1970') ? getPostDate(post) : '',
    location: post?.mapPlace?.location || post?.coverInfo?.location || post.title,
    excerpt: post?.excerpt || '',
    cover: (post.thumbnail || post.cover) ? url_for(post.thumbnail || post.cover) : '',
    mapUrl: post?.mapPlace?.url || post?.coverInfo?.url || '',
    lat: coordinate ? coordinate.lat : null,
    lng: coordinate ? coordinate.lng : null,
    hasCoordinate: Boolean(coordinate),
  };
}) : [];
const travelPlaces = allTravelCards.filter(item => item.hasCoordinate);
const showTravelMap = isTravelSeries && travelPlaces.length > 0;
const travelPlacesJson = encodeURIComponent(
  JSON.stringify(
    travelPlaces.map(({ excerpt, hasCoordinate, ...mapPlaceData }) => mapPlaceData)
  )
);
%>

<div class="series-layout<%=showTravelMap ? ' travel-series-layout' : ''%>">
  <% if (page.seriesInfo?.cover && !showTravelMap) { %>
  <div class="series-cover-img-wrap" style="<%=page.seriesInfo?.coverPlaceholder ? `background-image: url(${url_for(page.seriesInfo.coverPlaceholder)})`: ''%>">
    <div class="series-cover-img-placeholder"></div>
    <img id="seriesCoverImg" class="cover-img" src="<%=url_for(page.seriesInfo.cover)%>" alt="" fetchpriority="high" />
    <script>
      (function () {
        var img = document.getElementById('seriesCoverImg');
        if (!img) return;
        var now = typeof performance !== 'undefined' && performance.now ? function () { return performance.now(); } : Date.now;
        var start = now();
        var finish = function (isError) {
          img.classList.remove('loading');
          if (!isError) img.classList.add(now() - start > 300 ? 'loaded' : 'cached');
        };
        if (img.complete) {
          finish(img.naturalWidth === 0);
          return;
        }
        var timer = setTimeout(function () {
          if (!img.classList.contains('loaded') && !img.classList.contains('cached')) {
            img.classList.add('loading');
          }
        }, 100);
        img.addEventListener('load', function () { clearTimeout(timer); finish(false); }, { once: true });
        img.addEventListener('error', function () { clearTimeout(timer); finish(true); }, { once: true });
      })();
    </script>
    <div class="cover-info">
      <div class="series-info">
        <h1 class="series-name"><%=__('common.series') + ': ' + page.series %></h1>
        <div class="description"><%=page.seriesInfo.description||''%> <i class="post-count-icon"></i><%=__('common.total')%> <%=totalCount%> <%=__('common.seriesPostCount')%></div>
      </div>
      <% if(page.seriesInfo?.coverInfo) { %>
      <% if(page.seriesInfo.coverInfo.url) { %>
      <a class="copyright link" href="<%=page.seriesInfo.coverInfo.url%>" target="_blank" rel="noopener noreferrer">
        <% } else { %>
        <div class="copyright">
          <% } %>
          <span class="icon<%=page.seriesInfo.coverInfo.location? ' location': ''%>"></span>
          <span class="text"><%=page.seriesInfo.coverInfo.author||page.seriesInfo.coverInfo.location%></span>
          <% if(page.seriesInfo.coverInfo.url) { %>
      </a>
      <% } else { %>
        </div>
      <% } %>
      <% } %>
    </div>
  </div>
<% } else if (!showTravelMap) { %>
<%-partial('partials/taxonomy-header', {
  type: 'series',
  title: page.series,
  count: totalCount,
  yearRange,
  description: page?.seriesInfo?.description || '',
  kindLabel: __('common.series'),
  kindUrl: url_for('/archives/#series')
})%>
<% } %>

<% if (showTravelMap) { %>
<noscript>
  <link rel="stylesheet" href="<%-url_for('/linen-theme/css/leaflet.css')%>" />
</noscript>
<section class="travel-map-section" aria-label="<%=isEnglishMap ? 'Travel map' : '旅行地图'%>">
  <div class="travel-map-panel">
    <div class="travel-map-copy">
      <div class="travel-map-eyebrow"><%=isEnglishMap ? 'Travel Map' : '旅行地图'%></div>
      <h1><%=isEnglishMap ? 'Places I have been' : '去过的地方'%></h1>
      <div class="travel-map-stats">
        <span><%=allTravelCards.length%></span>
        <% if (travelPlaces.length < allTravelCards.length) { %>
        <%=isEnglishMap ? `${allTravelCards.length === 1 ? 'trip' : 'trips'} · ${travelPlaces.length} mapped` : `次旅行 · ${travelPlaces.length} 处足迹`%>
        <% } else { %>
        <%=isEnglishMap ? (allTravelCards.length === 1 ? 'mapped trip' : 'mapped trips') : '次旅行足迹'%>
        <% } %>
      </div>
    </div>
    <div
      id="travel-map"
      class="travel-map-canvas"
      data-places="<%=travelPlacesJson%>"
      data-map-lang="<%=String(page.language || config.language || '').startsWith('zh') ? 'zh' : 'en'%>"
      data-error-text="<%=isEnglishMap ? 'Map failed to load.' : '地图加载失败。'%>"
      data-leaflet-css="<%=url_for('/linen-theme/css/leaflet.css')%>"
      data-leaflet-js="<%=url_for('/linen-theme/js/leaflet.js')%>"
      data-map-style-light="<%=theme?.series?.mapStyleLight || ''%>"
      data-map-style-dark="<%=theme?.series?.mapStyleDark || ''%>"
    >
      <div class="travel-map-loading"><%=isEnglishMap ? 'Loading map...' : '地图加载中...'%></div>
      <noscript>
        <img
          class="travel-map-fallback-img"
          src="<%=url_for('/linen-theme/img/travel-map-fallback.svg')%>"
          alt="<%=isEnglishMap ? 'Static travel map' : '旅行地图静态图'%>"
        />
      </noscript>
    </div>
  </div>
  <div class="travel-place-list">
    <% allTravelCards.forEach((place, index) => { %>
    <article class="travel-place-card"<%- place.id ? ` data-travel-place="${place.id}"` : '' %>>
      <div class="travel-place-cover" aria-hidden="true">
        <span class="travel-place-index"><%=String(allTravelCards.length - index).padStart(2, '0')%></span>
        <% if (place.cover) { %>
        <div class="cover-img">
          <img src="<%=place.cover%>" alt="" loading="lazy" />
        </div>
        <% } %>
      </div>
      <div class="travel-place-body">
        <a class="travel-place-title" href="<%=place.path%>"><%=place.title%><% if (place.subTitle) { %><span class="sub-title"><%=place.subTitle%></span><% } %></a>
        <div class="travel-place-meta"><%=place.location%><% if (place.date) { %><span><%=place.date%></span><% } %></div>
        <div class="travel-place-excerpt"><%-place.excerpt%></div>
      </div>
    </article>
    <% }) %>
  </div>
</section>
<script src="<%=url_for(`/linen-theme/js/travel-map.js?v=${theme.version}`)%>" defer></script>
<% } %>

<% if (!showTravelMap) { %>
<div class="posts-info-layout">
  <div class="posts-wrap">
    <div id="recent-posts">
      <% currentSeriesPosts.forEach(post => { %>
      <%-partial('partials/post-item', { post: post })%> <% }) %>
    </div>
    <%-partial('partials/paginator')%>
  </div>
  <div class="info-wrap">
    <%-partial('partials/site-info')%>
    <%-partial('partials/taxonomy-sidebar', { type: 'series', items: seriesList, current: page.series })%>
  </div>
</div>
<% } %>
</div>
