<% if (page.cover) { %>
<div class="post-cover-img-wrap">
  <div class="post-cover-img-placeholder"></div>
  <div class="post-cover-img-placeholder-after"></div>
  <img id="postCoverImg" class="cover-img" src="<%=url_for(page.cover)%>" alt="" />
  <script>
    (function () {
      var img = document.getElementById('postCoverImg');
      if (!img) return;
      var now = typeof performance !== 'undefined' && performance.now ? function () { return performance.now(); } : Date.now;
      var start = now();
      var finish = function (isError) {
        img.classList.remove('loading');
        if (!isError) img.classList.add(now() - start > 300 ? 'loaded' : 'cached');
      };
      if (img.complete) {
        finish(img.naturalWidth === 0);
        return;
      }
      var timer = setTimeout(function () {
        if (!img.classList.contains('loaded') && !img.classList.contains('cached')) {
          img.classList.add('loading');
        }
      }, 100);
      img.addEventListener('load', function () { clearTimeout(timer); finish(false); }, { once: true });
      img.addEventListener('error', function () { clearTimeout(timer); finish(true); }, { once: true });
    })();
  </script>
  <% if(page.coverInfo) { %>
  <div class="cover-info">
    <% if(page.coverInfo.url) { %>
    <a class="copyright link" href="<%=page.coverInfo.url%>" target="_blank" rel="noopener noreferrer">
      <% } else { %>
      <div class="copyright">
        <% } %>
        <span class="icon<%=page.coverInfo.location? ' location': ''%>"></span>
        <span class="text"><%=page.coverInfo.author||page.coverInfo.location%></span>
        <% if(page.coverInfo.url) { %>
    </a>
    <% } else { %>
  </div>
  <% } %>
</div>
<% } %>
</div>
<% } %>

<% const postLayoutStyle = getPostLayoutStyle(page); %>
<article id="post" class="article layout-style-<%= postLayoutStyle %><%= postLayoutStyle === 'journal' ? ' travel-post' : '' %>">
  <h1 class="post-title"><%=page.title%><% if (page.subTitle) { %><span class="sub-title"><%=page.subTitle%></span><% } %></h1>
  <div class="post-meta">
    <% if (page.date && !date(page.date).startsWith('1970')) { %>
    <time class="date" datetime="<%=page.date.toJSON()%>">
      <%=getPostDate(page)%>
    </time>
    <% } %>
    <% if (page?.categories?.length) { %>
      <div class="categories">
        <% (page?.categories || []).forEach(category => { %>
        <a class="category-item" href="<%=url_for(`/${category.path}`)%>"><%=category.name%></a>
        <% }); %>
      </div>
    <% } %>
    <div class="read-time"><%-partial('partials/words', { post: page, count: page?.readTime?.count ?? true, readTime: true })%></div>
    <% if (page.appendRawMarkdown) { %>
      <div id="content-switch" role="button" tabindex="0" data-rawcontentlabel="<%-__('common.switchTo')+__('common.rawMarkdownContent')%>" data-renderedcontentlabel="<%-__('common.switchTo')+__('common.renderedContent')%>"><%-__('common.switchTo')+__('common.rawMarkdownContent')%></div>
    <% } %>
  </div>
  <% if (page.ageWarning && page.date && !date(page.date).startsWith('1970')) {
    const isAlreadyAged = (Date.now() - new Date(page.date).getTime()) > 180 * 1000 * 60 * 60 * 24;
  %>
    <div id="post-age-warning"<%- isAlreadyAged ? '' : ' style="display: none;"' %>><%-__('common.age_notice')%></div>
  <% } %>
  <div id="page-content"><%- renderTravelRoutes(page.content, page) %></div>
  <div id="page-content-end"></div>
  <div class="tags">
    <% (page.tags || []).forEach(tag => { %>
    <a class="tag-item" href="<%=url_for(`/${tag.path}`)%>"><%=tag.name%></a>
    <% }); %>
  </div>
</article>

<% if (!page?.series) { %>
<div class="post-nav-wrap">
  <div class="post-nav">
    <% if (page.prev) { %>
    <a class="post-nav-item prev" target="_self" href="<%= url_for(page.prev.path) %>"><span class="nav-indicator-text"><%=__('common.prevPost')%></span><span class="post-nav-title"><span class="item-link"><%= page.prev.title %></span><% if (page.prev.subTitle) { %><span class="sub-title"><%=page.prev.subTitle%></span><% } %></span></a>
    <% } %>
    <% if (page.next) { %>
    <a class="post-nav-item next" target="_self" href="<%= url_for(page.next.path) %>"><span class="nav-indicator-text"><%=__('common.nextPost')%></span><span class="post-nav-title"><span class="item-link"><%= page.next.title %></span><% if (page.next.subTitle) { %><span class="sub-title"><%=page.next.subTitle%></span><% } %></span></a>
    <% } %>
  </div>
</div>
<% } %>

<% if(page.donates) { %>
<div id="page-donates" role="button" tabindex="0" aria-haspopup="true"><%=__('common.donateToAuthor')%>
  <div id="donate-modal">
    <% page.donates.forEach(donateMethod => { %>
    <img class="qr-code" src="<%=url_for(donateMethod.qrcode)%>" alt="<%=donateMethod.type%>" />
    <% }); %>
  </div>
</div>
<% if (page.sponsors?.length) { %>
  <div class="sponsor-list">
    <div class="sponsor-list-header"><%=__('common.thanks')%></div>
    <ul>
      <% page.sponsors.forEach(sponsor => { %>
      <li class="sponsor-item">
        <span class="sponsor-name"><%=sponsor.name%></span>
        <span class="sponsor-amount"><%=__('common.sponsored')%> <%=sponsor.amount%></span>
        <span class="sponsor-date"><%=getPostDate(sponsor.date)%></span>
        <% if (sponsor.message && String(sponsor.message).trim()) { %>
        <div class="sponsor-message"><%=String(sponsor.message).trim()%></div>
        <% } %>
      </li>
    <% }); %>
    </ul>
  </div>
<% } %>
<% } %>

<% if (page?.series) { 
var series = site.posts.filter(item=>item.series && item.series === page?.series && !item?.hide?.archive).sort('date', -1).toArray()
const currentIndex = series.findIndex(item=>item.source === page.source);
const previousPost = series[currentIndex - 1] || null;
const nextPost = series[currentIndex + 1] || null;
const seriesInfo = getSeriesInfo(page?.series);
%>
<div class="series-nav">
  <div class="series-name" role="button" tabindex="0" aria-controls="series">
    <div class="series-name-content">
      <i class="series-icon"></i>
      <span><%=page?.series%></span>
      <span class="dot"></span>
      <span><%=__('common.toc')%></span>
    </div>
  </div>

  <% if (previousPost || nextPost) { %>
  <div class="post-nav-wrap">
    <div class="post-nav">
      <% if (previousPost) { %>
      <a class="post-nav-item prev" target="_self" href="<%=url_for(previousPost.path)%>"><span class="nav-indicator-text"><%=__('common.prevPost')%></span><span class="post-nav-title"><span class="item-link"><%=previousPost.title %></span><% if (previousPost.subTitle) { %><span class="sub-title"><%=previousPost.subTitle%></span><% } %></span></a>
      <% } %>
      <% if (nextPost) { %>
      <a class="post-nav-item next" target="_self" href="<%=url_for(nextPost.path)%>"><span class="nav-indicator-text"><%=__('common.nextPost')%></span><span class="post-nav-title"><span class="item-link"><%=nextPost.title %></span><% if (nextPost.subTitle) { %><span class="sub-title"><%=nextPost.subTitle%></span><% } %></span></a>
      <% } %>
    </div>
  </div>
  <% } %>

  <div id="series" class="series-popup">
    <div class="popup-header">
      <span class="close-series-popup-icon-wrap" role="button" tabindex="0" aria-label="<%=__('common.close')%>">
        <i class="close-series-popup-icon"></i>
      </span>
      <span class="title"><%=page?.series%></span>
      <span class="details-link">
        <a href="<%=url_for(`/series/${encodeURIComponent(page.series)}/`)%>"><%=__('common.details')%></a>
      </span>
    </div>
    <div class="series-items">
      <%
      let currentSeriesYear = null;
      series.forEach((item, index) => {
        const itemYear = item.date?.year ? item.date.year() : new Date(item.date).getFullYear();
        const showYearDivider = seriesInfo?.yearDivider && itemYear && itemYear !== currentSeriesYear;
        const showIndex = seriesInfo?.showMobileIndex !== false
        if (showYearDivider) {
          currentSeriesYear = itemYear;
        }
      %>
      <% if (showYearDivider) { %>
      <div class="series-year-divider"><%=itemYear%></div>
      <% } %>
      <a class="series-item-link<%-item.source === page.source ? ' active': ''%>" href="<%=url_for(item.path)%>">
        <% if (showIndex) { %><span class="item-index"><%-`${seriesInfo?.noOrder === 'asc' ? index + 1 : series.length - index}. `%></span><% }%><%=item.title%><% if (item.subTitle) { %><span class="sub-title"><%=item.subTitle%></span><% } %>
      </a>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<% if (page.copyright) { %>
<div class="copyright-desc"><%=__('common.copyrightDesc')%></div>
<% } %>

<% const commentEnabled = Boolean(theme.comment) && (page.comment === true || (page.comment !== false && theme.comment.enable !== false)); %>
<% if (commentEnabled) {
  const rawCommentProvider = String(theme.comment.provider || '').trim().toLowerCase();
  const commentProvider =
    rawCommentProvider === 'giscus' ||
    (!rawCommentProvider && (theme.comment.repo_id || theme.comment.category_id))
      ? 'giscus'
      : 'gitalk';
%>
<% if (commentProvider === 'giscus') {
  const giscusConfig = {
    repo: theme.comment.repo || '',
    repoId: theme.comment.repo_id || '',
    category: theme.comment.category || '',
    categoryId: theme.comment.category_id || '',
    mapping: theme.comment.mapping || 'pathname',
    term: theme.comment.term || '',
    strict: theme.comment.strict ?? '0',
    reactionsEnabled: theme.comment.reactions_enabled ?? '1',
    emitMetadata: theme.comment.emit_metadata ?? '0',
    inputPosition: theme.comment.input_position || 'top',
    theme: theme.comment.theme || '',
    lightTheme: theme.comment.light_theme || 'linen',
    darkTheme: theme.comment.dark_theme || 'linen',
    linenLightCss: url_for(`/linen-theme/css/giscus-linen-light.css?v=${theme.version}`),
    linenDarkCss: url_for(`/linen-theme/css/giscus-linen-dark.css?v=${theme.version}`),
    lang: theme.comment.lang || page.language || config.language || 'en',
    errorText: __('common.commentsLoadError'),
  };
%>
<div id="giscus-container" class="giscus-container is-loading<%= String(giscusConfig.reactionsEnabled) === '0' ? ' no-reactions' : '' %>">
  <div class="giscus-loading" role="status" aria-live="polite">
    <span class="giscus-loading-spinner" aria-hidden="true"></span>
    <span class="giscus-loading-text"><%=__('common.commentsLoading')%></span>
  </div>
</div>
<script id="linen-giscus-config" type="application/json"><%- JSON.stringify(giscusConfig).replace(/<\//g, '<\\/') %></script>
<script src="<%=url_for(`/linen-theme/js/giscus-init.js?v=${theme.version}`)%>" defer></script>
<% } else {
  const gitalkConfig = {
    cssUrl: url_for(`/linen-theme/js/gitalk/gitalk.css?v=${theme.version}-gitalk`),
    jsUrl: url_for(`/linen-theme/js/gitalk/gitalk.min.js?v=${theme.version}-gitalk`),
    clientID: theme.comment.client_id || '',
    clientSecret: theme.comment.client_secret || '',
    repo: theme.comment.repo || '',
    owner: theme.comment.owner || '',
    admin: theme.comment.admin || '',
    proxy: theme.comment.proxy || '',
    language: page.language || config.language || 'en',
    pagerDirection: theme.comment.pager_direction ?? 'last',
  };
%>
<div id="gitalk-container"></div>
<script id="linen-gitalk-config" type="application/json"><%- JSON.stringify(gitalkConfig).replace(/<\//g, '<\\/') %></script>
<script src="<%=url_for(`/linen-theme/js/gitalk-init.js?v=${theme.version}`)%>" defer></script>
<% } %>
<% } %>

<% if ([theme?.photoswipe ?? config?.theme_config?.photoswipe, page.photoswipe ?? true, /<img|\/static\/live-photo\/|live-photo-gallery-item|data-live-photo-src/.test(page?.content)].every(enable=>enable)) {
  const version = theme.version;
  const hdrAssetsPrefix = page?.hdrAssetsPrefix || '';
  const useMsrcPlaceholder = Boolean(
    page.photoswipeUseMsrcPlaceholder ??
      theme?.photoswipe?.useMsrcPlaceholder ??
      config?.theme_config?.photoswipe?.useMsrcPlaceholder ??
      (page.path === 'gallery/index.html')
  );
%>
<link rel="stylesheet" href="<%=url_for(`/linen-theme/css/photoswipe.css?v=${version}`)%>" />
<link rel="stylesheet" href="<%=url_for(`/linen-theme/css/photoswipe-dynamic-caption-plugin.css?v=${version}`)%>" />
<script
  id="linen-photoswipe-init"
  type="module"
  src="<%=url_for(`/linen-theme/js/photoswipe-init.js?v=${version}`)%>"
  data-hdr-assets-prefix="<%=hdrAssetsPrefix%>"
  data-use-msrc-placeholder="<%=useMsrcPlaceholder ? 'true' : 'false'%>"
></script>
<% } %>

<%-partial('partials/related-posts')%>
