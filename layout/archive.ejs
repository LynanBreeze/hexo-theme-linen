<%
const visiblePosts = site.posts.filter(post => !post?.hide?.archive);
const tagsList = list_tags({ show_count: false });
const seriesList = Array.from(new Set(visiblePosts.filter(item=>item.series).map(item=>item.series))).map(seriesName=>({
  name: seriesName,
  count: visiblePosts.filter(post=>post.series === seriesName).length
}));
const categoriesList = site.categories && typeof site.categories.toArray === 'function'
  ? site.categories.toArray()
      .map(cat => ({
        name: cat.name,
        path: cat.path,
        count: cat.posts ? cat.posts.filter(post => !post?.hide?.archive).length : cat.length
      }))
      .filter(cat => cat.count > 0)
  : Object.entries(visiblePosts.reduce((acc, post) => {
      (post?.categories || []).forEach(cat => acc[cat.name] = (acc[cat.name] || 0) + 1);
      return acc;
    }, {})).map(([name, count]) => ({ name, path: '', count }));
const archivesList = Object.entries(visiblePosts.reduce((acc, post) => {
  const year = post.date.year();
  acc[year] = (acc[year] || 0) + 1;
  return acc;
}, {})).map(([name, count]) => ({ year: name, name: name.startsWith('1970') ? '__' : name, count })).reverse();
%>

<% if (is_year() === false) { %>
<div id="archive">
  <h1 class="sr-only"><%=__('common.archives')%></h1>
  <div class="two-columns">
    <% if(categoriesList.length) {%>
      <aside>
      <h2 id="categories"><%=__('common.categories')%></h2>
      <ul class="archive-list">
        <% categoriesList.forEach(category => {
          const categoryHref = category.path
            ? url_for(`/${String(category.path).replace(/^\/+/, '')}`)
            : url_for(`/categories/${encodeURIComponent(category.name)}/`);
        %>
        <li class="archive-list-item">
          <a class="archive-list-link" data-firstletter="<%=category.name.charAt(0)%>" href="<%=categoryHref%>">
            <%=category.name%>
            <span class="archive-list-count"><%=category.count%></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </aside>
    <% } %>
    <aside>
      <h2 id="archives"><%=__('common.posts')%></h2>
      <ul class="archive-list">
        <% archivesList.forEach(archive => { %>
        <li class="archive-list-item">
          <a class="archive-list-link" data-firstletter="<%=archive.name.charAt(archive.name.length-1)%>" href="<%=url_for(`/archives/${archive.year}/`)%>">
            <%=archive.name%>
            <span class="archive-list-count"><%=archive.count%></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </aside>
  </div>

 

  <% if(seriesList.length) { %>
  <br>
  <aside>
    <h2 id="series"><%=__('common.series')%></h2>
    <ul class="archive-list">
      <% seriesList.forEach(series => { %>
      <li class="archive-list-item">
        <a class="archive-list-link" data-firstletter="<%=series.name.charAt(0)%>" href="<%=url_for(`/series/${encodeURIComponent(series.name)}/`)%>">
          <%=series.name%>
          <span class="archive-list-count"><%=series.count%></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </aside>
  <% } %>

  <% if(tagsList.length) { %>
  <br>
  <aside>
    <h2 id="tags"><%=__('common.tags')%></h2>
    <div class="tag-list-wrap">
      <% if (tagsList !== "") { %>
      <%-tagsList%>
      <% } %>
    </div>
  </aside>
  <% } %>

</div>
<% } else { %>
<%
const archiveTitle = page.year.toString().startsWith('1970') ? '__' : (page.month ? page.month + '/' : '') + page.year;
const archivePosts = site.posts.filter(post => {
  if (post?.hide?.archive || !post?.date) return false;
  if (post.date.year() !== Number(page.year)) return false;
  if (page.month && post.date.month() + 1 !== Number(page.month)) return false;
  return true;
});
%>
<%-partial('partials/taxonomy-header', {
  type: 'archive',
  title: archiveTitle,
  count: archivePosts.length,
  yearRange: '',
  description: '',
  kindLabel: __('common.archives'),
  kindUrl: url_for('/archives/#archives')
})%>
<div class="posts-info-layout">
  <div class="posts-wrap">
    <%-partial('partials/recent-posts', { showHidden: true })%>
    <%-partial('partials/paginator')%>
  </div>
  <div class="info-wrap">
    <%-partial('partials/site-info')%>
    <%-partial('partials/taxonomy-sidebar', { type: 'archive', items: archivesList, current: page.year })%>
  </div>
</div>
<% } %>